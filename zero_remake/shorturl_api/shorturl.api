syntax = "v1"

type (
    // 生成短链接请求
    GenerateRequest {
        Url        string `json:"url"` // 原始URL
        Expiration string `json:"expiration"` // 过期时间，例如 "1h", "30m", "1d"
    }
	// 生成短链接响应
	GenerateResponse {
		Code     int    `json:"code"` // 状态码
		ShortUrl string `json:"short_url"` // 生成的短链接
		Message  string `json:"message"` // 消息
	}
	// 短链接跳转请求
	RedirectRequest {
		ShortURL string `path:"shortURL"` // 短链接参数
	}
	// 短链接模型
	RedirectResponse {
		Code         int    `json:"code"` // 状态码
		OringinalUrl string `json:"original_url"` // 原始URL
		Message      string `json:"message"` // 消息
	}
)

type (
	UserLoginRequest {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	UserLoginResponse {
		Code        int    `json:"code"`
		Message     string `json:"message"`
		AccessToken string `json:"access_token"`
		ExpiresIn   int64  `json:"expires_in"`
	}
	UserRegisterRequset {
		Username        string `json:"username"`
		Password        string `json:"password"`
		ConfirmPassword string `json:"confirm_password"`
	}
	UserRegisterResponse {
		Code int `json:"code"`
	}
)

type (
	qpsResponse {
		Code    int     `json:"code"`
		Message string  `json:"message"`
		QPS     float64 `json:"qps"`
	}
)

@server (
	prefix: /users
)
service shorturl-api {
	@handler Login
	post /login (UserLoginRequest) returns (UserLoginResponse)

	@handler Register
	post /register (UserRegisterRequset) returns (UserRegisterResponse)
}

@server (
	prefix: /shorturls
	jwt:    Auth
)
service shorturl-api {
	@handler Generate
	post /generate (GenerateRequest) returns (GenerateResponse)

	@handler GenerateIDbMySnowflake
	post /generatebymysnowflake (GenerateRequest) returns (GenerateResponse)

	@handler FilterByMyBloomFilter
	post /filterbymybloomfilter (GenerateRequest) returns (GenerateResponse)

	@handler GenerateWithIPLimter
	post /generatewithiplimiter (GenerateRequest) returns (GenerateResponse)

	@handler Redirect
	get /:shortURL (RedirectRequest) returns (RedirectResponse)
}

@server (
	prefix: /qps
	jwt:    Auth
)
service shorturl-api {
	@handler GetQPS
	get /getqps (qpsResponse)
}

